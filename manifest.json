{
  "manifest_version": 3,
  "name": "Privacy & Tracker Visualizer",
  "version": "1.0.0",
  "description": "Scan websites and get a Privacy Grade based on tracking scripts and cookies",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Privacy Visualizer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script.js"]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
